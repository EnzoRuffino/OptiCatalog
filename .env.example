# Copie ce fichier en .env (racine du repo ou packages/database) et remplis les valeurs

# Prisma 7 : utilisée par prisma.config.mjs (migrate) et par l’adaptateur pg à l’exécution
DATABASE_URL="postgresql://user:password@localhost:5432/catalog"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
PLAN_LIMIT_STARTER="2000"
PLAN_LIMIT_PRO="10000"
PLAN_LIMIT_SCALE="35000"
