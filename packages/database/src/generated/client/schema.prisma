// Indique à Prisma quel générateur utiliser (le client TypeScript)
generator client {
  provider = "prisma-client-js"
  // Le client sera généré ici, dans le package database
  output   = "../src/generated/client"
}

// URL de connexion : Prisma 7 → prisma.config.mjs (CLI) + adaptateur pg à l’exécution
datasource db {
  provider = "postgresql"
}

// ─── USER ────────────────────────────────────────────────────────────────────
model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  plan         SubscriptionPlan @default(STARTER)

  // Un utilisateur peut avoir plusieurs projets
  projects     Project[]
  usageMonthly UsageMonthly[]
}

// ─── PROJECT ──────────────────────────────────────────────────────────────────
model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Clé étrangère vers User
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Un projet contient plusieurs produits, pages collection et jobs
  products        Product[]
  collectionPages CollectionPage[]
  jobs            Job[]
}

// ─── PRODUCT ──────────────────────────────────────────────────────────────────
model Product {
  id                  String   @id @default(cuid())
  originalTitle       String
  originalDescription String
  price               Float
  // Champs libres stockés en JSON (couleur, taille, matière...)
  attributes          Json     @default("{}")
  imageUrl            String?
  imageAlt            String?
  createdAt           DateTime @default(now())

  // Clé étrangère vers Project
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  // Un produit peut avoir une génération IA
  generation Generation?
}

// ─── GENERATION ───────────────────────────────────────────────────────────────
// Contient le résultat de l'optimisation IA pour un produit
model Generation {
  id                   String   @id @default(cuid())
  optimizedTitle       String
  optimizedDescription String
  seoKeywords          String // Mots-clés séparés par des virgules
  seoScore             Int // Score de 0 à 100
  createdAt            DateTime @default(now())

  // Relation 1-à-1 avec Product
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])
}

// ─── COLLECTION PAGE (catégorie / page liste) ────────────────────────────────
model CollectionPage {
  id                  String   @id @default(cuid())
  label               String
  originalDescription String   @default("")
  createdAt           DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  generation CollectionGeneration?
}

model CollectionGeneration {
  id                   String   @id @default(cuid())
  optimizedTitle       String
  optimizedDescription String
  seoKeywords          String
  seoScore             Int
  createdAt            DateTime @default(now())

  collectionPageId String         @unique
  collectionPage   CollectionPage @relation(fields: [collectionPageId], references: [id], onDelete: Cascade)
}

// ─── JOB ──────────────────────────────────────────────────────────────────────
// Représente un traitement asynchrone (optimisation d'un lot de produits)
model Job {
  id           String    @id @default(cuid())
  status       JobStatus @default(PENDING)
  progress     Int       @default(0) // 0 à 100
  createdAt    DateTime  @default(now())
  // Détail d’échec (ex. erreur OpenAI / produit introuvable)
  errorMessage String?

  // Clé étrangère vers Project
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}

// Les états possibles d'un job
enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ─── USAGE MONTHLY ───────────────────────────────────────────────────────────
model UsageMonthly {
  id                 String   @id @default(cuid())
  userId             String
  monthKey           String // format: YYYY-MM
  optimizedProducts  Int      @default(0)
  estimatedCostCents Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, monthKey])
}

enum SubscriptionPlan {
  STARTER
  PRO
  SCALE
}
